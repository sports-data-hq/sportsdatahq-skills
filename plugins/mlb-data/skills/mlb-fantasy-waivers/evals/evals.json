      "platoon bat I can pick up",
      "who is hitting leadoff now",
      "a catcher to add",
      "shortstop pickup",
      "waiver add for my injured outfielder"
    ],
    "should_not": [
      "who do I stream Tuesday",
      "two-start pitchers this week",
      "build my DraftKings MLB lineup",
      "who is due to regress",
      "has this pitcher's slider changed",
      "Ohtani hits prop line",
      "MLB playoff odds",
      "preview Dodgers Padres",
      "MLB standings",
      "trade my Soto for his Judge"
    ]
  }
